# Maintainer: GeminiDesk Contributors
# Arch Linux / CachyOS PKGBUILD for GeminiDesk (Wayland / KDE Plasma / X11)

pkgname=geminidesk
pkgver=1.0.0
pkgrel=1
pkgdesc="Lightweight native Rust desktop client for Google Gemini (WebKitGTK)"
arch=('x86_64' 'aarch64')
url="https://github.com/existye4t/gemini-desk"
license=('MIT' 'Apache-2.0')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'openssl'
  'xdg-desktop-portal'
)
makedepends=(
  'rust'
  'cargo'
  'pkgconf'
)
optdepends=(
  'xdg-desktop-portal-kde: Native KDE Plasma Wayland global shortcuts, screenshots, and dark mode'
  'xdg-desktop-portal-gtk: GNOME/GTK Wayland portal support'
  'wl-clipboard: Wayland clipboard actions and primary selection capture (wl-copy/wl-paste)'
  'xclip: X11 clipboard actions and primary selection capture'
  'spectacle: KDE fallback interactive region screenshot capture'
  'grim: wlroots fallback screenshot capture'
  'slurp: wlroots region selector for grim'
  'libnotify: Fallback desktop notifications (notify-send) if D-Bus notifications are unavailable'
)
source=()
sha256sums=()

_resolve_srcdir() {
  if [[ -f "${startdir}/../../Cargo.toml" ]]; then
    cd "${startdir}/../.." && pwd
  elif [[ -d "${srcdir}/gemini-desk-${pkgver}" ]]; then
    cd "${srcdir}/gemini-desk-${pkgver}" && pwd
  else
    cd "${srcdir}/${pkgname}-${pkgver}" && pwd
  fi
}

prepare() {
  cd "$(_resolve_srcdir)"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$(_resolve_srcdir)"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$(_resolve_srcdir)"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$(_resolve_srcdir)"
  install -Dm755 "target/release/gemini-desk" "${pkgdir}/usr/bin/gemini-desk"
  install -Dm644 "packaging/linux/io.geminidesk.GeminiDesk.desktop" \
    "${pkgdir}/usr/share/applications/io.geminidesk.GeminiDesk.desktop"
  install -Dm644 "packaging/linux/io.geminidesk.GeminiDesk.metainfo.xml" \
    "${pkgdir}/usr/share/metainfo/io.geminidesk.GeminiDesk.metainfo.xml"
  install -Dm644 "assets/icons/geminidesk.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/io.geminidesk.GeminiDesk.svg"
  install -Dm644 "assets/icons/geminidesk-256.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/io.geminidesk.GeminiDesk.png"
  install -Dm644 "assets/icons/geminidesk-512.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/io.geminidesk.GeminiDesk.png"
  install -Dm644 "THIRD_PARTY_LICENSES.md" \
    "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_LICENSES.md"
  install -Dm644 "assets/fonts/OFL-Geist.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/OFL-Geist.txt"
}
